# ===== Telegram =====
BOT_TOKEN=123456:AA...
# ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# ===== Инфраструктура =====
DB_DSN=postgresql+asyncpg://bot:bot@postgres:5432/filterbot
REDIS_DSN=redis://redis:6379/0
# для docker-compose (служба postgres)
POSTGRES_DB=filterbot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot

# ===== Логика воронки =====
PER_USER_INVITE_LINKS=false
AUTO_APPROVE_JOIN_REQUESTS=true
# true — неизвестный ?start=код сам заводит новую ссылку (удобно на старте,
# но плодит мусорные строки в отчёте). Ссылки выдаёт админ — держим false.
AUTO_CREATE_UNKNOWN_LINKS=false
APPROVE_DELAY=0

# ===== Рассылки =====
BROADCAST_RATE=20
BROADCAST_BATCH=500

# ===== Google Sheets (опционально) =====
# ID из URL таблицы: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=secrets/google.json
SHEETS_SYNC_INTERVAL=30

# ===== Прочее =====
# Первичная заливка каналов при старте (см. channels.example.json)
SEED_CHANNELS_FILE=
LOG_LEVEL=INFO
TZ_NAME=Europe/Moscow
SUPPORT_URL=
